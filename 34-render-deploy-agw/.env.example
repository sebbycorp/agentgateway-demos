# Set these in the Render Environment tab. Never commit real values.
# Only UI_PASSWORD is required. Provider keys are optional: first boot
# writes $OPENAI_API_KEY / GitHub MCP only when those env vars are set.

PORT=4000
UI_USER=admin
UI_PASSWORD=

# Optional. Leave empty to skip the OpenAI wildcard model.
OPENAI_API_KEY=
# Optional. Not seeded; add an Anthropic model in the UI if you use it.
ANTHROPIC_API_KEY=
# Optional. Leave empty to skip GitHub remote MCP.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Virtual LLM keys live in /config/config.yaml (or the UI), not in git.
# Placeholders only — rotate anything that was ever pasted into a screenshot.
# sk-lab-admin-...
# sk-lab-demo-...
# sk-lab-limited-...
