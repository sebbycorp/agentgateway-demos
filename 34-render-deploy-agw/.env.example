# Set these in the Render Environment tab. Never commit real values.
# First boot writes $OPENAI_API_KEY into /config/config.yaml (plus
# placeholder virtual keys). GitHub MCP is optional: set
# GITHUB_PERSONAL_ACCESS_TOKEN to seed that target.

PORT=4000
UI_USER=admin
UI_PASSWORD=

OPENAI_API_KEY=
# Optional. Leave empty to skip GitHub remote MCP.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Virtual LLM keys live in /config/config.yaml (or the UI), not in git.
# Placeholders only — rotate anything that was ever pasted into a screenshot.
# sk-lab-admin-...
# sk-lab-demo-...
# sk-lab-limited-...
