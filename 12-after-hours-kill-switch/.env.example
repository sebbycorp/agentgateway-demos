# Copy to .env (gitignored) and fill in. Never commit real keys.
#   cp .env.example .env

# OpenAI — used for public model gpt-4o-mini during daytime + x-env: prod
# Upstream model: gpt-4o-mini
OPENAI_API_KEY=

# Anthropic — used for public model claude-sonnet during daytime + x-env: prod
# Upstream model: claude-sonnet-4-6
ANTHROPIC_API_KEY=

# xAI — used for public model grok, and as the after-hours / non-prod kill switch
# Upstream model: grok-4.6
XAI_API_KEY=
