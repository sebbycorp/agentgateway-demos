# Copy to .env (gitignored). Names only — never commit real values.
#
# Required to apply. Do not paste a license into git, README, or screenshots.
# TF_VAR_agentgateway_license_key=
# AGENTGATEWAY_LICENSE_KEY=

LAB_GCP_PROJECT=maniak-io
LAB_GCP_REGION=us-central1
LAB_HOSTNAME=agw-gcp-ha.maniak.io

# Optional overrides (non-secret)
# TF_VAR_project_id=maniak-io
# TF_VAR_region=us-central1
# TF_VAR_hostname=agw-gcp-ha.maniak.io
# TF_VAR_dns_zone_name=maniak.io.
# TF_VAR_dns_managed_zone=maniak
# LAB_DNS_ZONE_NAME=maniak.io.
# LAB_DNS_MANAGED_ZONE=maniak
# TF_VAR_agentgateway_image=cr.agentgateway.dev/agentgateway:2026.9.0
