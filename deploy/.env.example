# Provider keys — set these in the PaaS dashboard, never commit real values.
# The generated /config/config.yaml expands $OPENAI_API_KEY (and friends)
# when you add a model in the UI or edit the file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stdio MCP (@modelcontextprotocol/server-github) reads this from the
# process environment when you add that target. Leave empty if unused.
GITHUB_PERSONAL_ACCESS_TOKEN=

# UI basic auth (required). The entrypoint writes /config/.htpasswd from
# these on every start. Do not commit real passwords.
# Browser /ui/ prompts for this pair. LLM routes on :4000 do not.
UI_PASSWORD=
# Optional; defaults to admin.
UI_USER=admin
