# Provider keys are optional — set these in the PaaS dashboard, never commit
# real values. First boot writes $OPENAI_API_KEY / GitHub MCP only when set.
# The gateway exits if config.yaml expands a $VAR that is missing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Seed GitHub remote MCP when set. Also used if you add stdio
# @modelcontextprotocol/server-github later.
GITHUB_PERSONAL_ACCESS_TOKEN=

# UI basic auth (required). The entrypoint writes /config/.htpasswd from
# these on every start. Do not commit real passwords.
# Browser /ui/ prompts for this pair. LLM routes on :4000 do not.
UI_PASSWORD=
# Optional; defaults to admin.
UI_USER=admin
